# Copy to .env for local configuration. The app runs with defaults without it.
# Optional. If unset, the app tries port 3000 and advances if occupied.
PORT=
NODE_ENV=development
SESSION_HOURS=12
DATA_FILE=./data/store.json

# Netlify email OTP account verification
FIREBASE_SERVICE_ACCOUNT=
RESEND_API_KEY=
AUTH_OTP_FROM_EMAIL=no-reply@ukid-templates.com
FIREBASE_WEB_API_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_OTP_SECRET=

# Optional local learning-workspace assistant configuration
WORKSPACE_PORT=5501
WORKSPACE_OLLAMA_MODE=local
WORKSPACE_OLLAMA_URL=http://127.0.0.1:11434/api/generate
WORKSPACE_MODEL=qwen2.5-coder:3b
WORKSPACE_MODELS=
WORKSPACE_OLLAMA_TOKEN=
